# ---------- Miniapp React build stage ----------
FROM node:20-alpine AS react-build

ARG BUILD_TIME
ENV VITE_BUILD_TIME=$BUILD_TIME

WORKDIR /app

COPY apps/miniapp-agents/package*.json ./apps/miniapp-agents/
COPY packages/miniapp-shared/package*.json ./packages/miniapp-shared/

RUN cd apps/miniapp-agents && npm install

COPY apps ./apps
COPY packages ./packages

RUN cd apps/miniapp-agents && \
    npx vite build --outDir /built-agents && \
    test -f /built-agents/index.html

# ---------- Dashboard React build stage ----------
FROM node:20-alpine AS dashboard-build

WORKDIR /app

COPY dashboard/package*.json ./dashboard/
RUN cd dashboard && npm ci

COPY dashboard ./dashboard
COPY shared ./shared
RUN cd dashboard && npx vite build --outDir /built-dashboard

# ---------- Backend stage ----------
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

COPY bot /app/bot
COPY alembic /app/alembic
COPY alembic.ini pyproject.toml /app/

COPY bot/dashboard/frontend /app/bot/dashboard/frontend
COPY --from=react-build /built-agents /app/bot/dashboard/frontend/agents
COPY --from=dashboard-build /built-dashboard /app/bot/dashboard/browser

CMD ["uvicorn", "bot.dashboard.api.main:app", "--host", "0.0.0.0", "--port", "8080"]
