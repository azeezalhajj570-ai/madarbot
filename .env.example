# Bot
BOT_APP_KIND=agents
AGENTS_BOT_TOKEN=your_agents_bot_token
BOT_TOKEN=fallback_token

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/combot
DB_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Language
DEFAULT_LANGUAGE=ar

# Logging
LOG_LEVEL=INFO
AIROGRAM_LOG_LEVEL=WARNING
LOG_RAW_UPDATES=false

# WebApp URLs
AGENTS_WEBAPP_URL=http://localhost:5175
WEBAPP_URL=http://localhost:5175
DASHBOARD_URL=http://localhost:5175/webapp
TELEGRAM_WEBAPP_AUTH_MAX_AGE_SECONDS=86400

# Dashboard JWT
DASHBOARD_JWT_SECRET=your_strong_random_secret

# AI Providers
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=

# Stripe (optional)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Whop (optional) - agents mini app subscriptions
WHOP_ENABLED=false
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
WHOP_PLAN_ID_PRO=
WHOP_PLAN_ID_BUSINESS=
# Use https://sandbox-api.whop.com/api/v1 to test against the Whop sandbox
WHOP_API_BASE_URL=https://api.whop.com/api/v1
WHOP_CHECKOUT_BASE_URL=https://whop.com
WHOP_TRIAL_DAYS=7
WHOP_RENEWAL_DAYS=30

# Sentry (optional)
SENTRY_DSN=

# Telegram API (for agent accounts)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SCRAPER_HISTORY_PAGE_SIZE=100
SCRAPER_HISTORY_PAUSE_SECONDS=0.2
SCRAPER_FLOOD_WAIT_CAP_SECONDS=300

# Session encryption
SESSION_ENCRYPTION_KEY=

# Bot owners
BOT_OWNER_IDS=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=25

# Job scheduler / reconciliation
RECONCILE_ENABLED=true
RECONCILE_POLL_INTERVAL=300
PENDING_JOB_REQUEUE_MINUTES=5

# AI Agent Features
ENABLE_AI_REPLIES=true
ENABLE_LEAD_CAPTURE=true
ENABLE_AGENT_AUTOMATION=true

# DB Auto-Backup (config is edited from the dashboard; these are env defaults)
# BACKUP_ENABLED=true starts the backup loop; the dashboard toggle actually schedules backups.
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_HOURS=24
# Google Drive OAuth (optional; can be entered from the dashboard instead)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
