# Bot
BOT_APP_KIND=agents
AGENTS_BOT_TOKEN=your_agents_bot_token
BOT_TOKEN=fallback_token

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/combot

# Redis
REDIS_URL=redis://localhost:6379/0

# Language
DEFAULT_LANGUAGE=ar

# Logging
LOG_LEVEL=INFO
AIROGRAM_LOG_LEVEL=WARNING
LOG_RAW_UPDATES=false

# WebApp URLs
AGENTS_WEBAPP_URL=http://localhost:5175
WEBAPP_URL=http://localhost:5175
DASHBOARD_URL=http://localhost:5175/webapp
TELEGRAM_WEBAPP_AUTH_MAX_AGE_SECONDS=86400

# Dashboard JWT
DASHBOARD_JWT_SECRET=your_strong_random_secret

# AI Providers
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=

# Stripe (optional)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Sentry (optional)
SENTRY_DSN=

# Telegram API (for agent accounts)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SCRAPER_HISTORY_PAGE_SIZE=100
SCRAPER_HISTORY_PAUSE_SECONDS=0.2
SCRAPER_FLOOD_WAIT_CAP_SECONDS=300

# Session encryption
SESSION_ENCRYPTION_KEY=

# Bot owners
BOT_OWNER_IDS=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=25

# AI Agent Features
ENABLE_AI_REPLIES=true
ENABLE_LEAD_CAPTURE=true
ENABLE_AGENT_AUTOMATION=true
